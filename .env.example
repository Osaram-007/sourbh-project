# Database Connection (PostgreSQL with PostGIS extension)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fullcharge?schema=public"

# NextAuth.js Authentication Configuration
NEXTAUTH_SECRET="your-super-secret-nextauth-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google Maps Platform API Key (Client-side)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Upstash Redis / Redis Configuration (Optional Caching)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Behavior-analytics snapshot retention, in days (default 365 if unset)
SNAPSHOT_RETENTION_DAYS=365

# T0-04
# Comma-separated admin emails (case-insensitive). Admin = role ADMIN AND email listed here.
# Unset or empty = nobody is admin: every /api/admin/* and /api/analytics/* call returns 403.
ADMIN_EMAILS="owner@example.com"
