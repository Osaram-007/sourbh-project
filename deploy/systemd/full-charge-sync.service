[Unit]
Description=Full Charge - EV station data collector (sync worker)
After=network.target postgresql.service

[Service]
Type=simple
User=fullcharge
WorkingDirectory=/opt/full-charge
ExecStart=/usr/bin/npm run sync:worker
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
